# Hostinger runs Apache, so a SPA needs this to send every unknown path
# back to index.html — except for real files and folders that exist on disk.
# The TanStack Start landing page only has the `/` route, but we keep this
# defensive so future client-side routes resolve on refresh.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # If the request corresponds to a real file or folder, serve it as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Otherwise send the request to index.html so the SPA router takes over.
  RewriteRule ^ index.html [L]
</IfModule>

# Long cache for versioned assets (the /assets/ folder Vite emits with hashes).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Prevent Hostinger's default directory listing from triggering 403 noise.
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>
